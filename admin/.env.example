# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# RSVP → Telegram notification (server-side; set in Vercel env)
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# chat.id of each phone (from https://api.telegram.org/bot<TOKEN>/getUpdates after each sends /start)
TELEGRAM_GROOM_CHAT_ID=
TELEGRAM_BRIDE_CHAT_ID=
# shared secret; also set as the `x-webhook-secret` header on the Supabase DB webhook
RSVP_WEBHOOK_SECRET=
